# Where the FastAPI service lives. Read server-side only: the browser talks to
# the Next proxy route, never directly to the API.
API_BASE_URL=http://127.0.0.1:8000

# How this server decides who a request is for — see docs/authentication.md.
#   development  (default) everyone is DEV_USER_EMAIL.
#   dev-session  a per-browser session from a development sign-in form: any
#                address, no password. NOT authentication. Needs SESSION_SECRET.
#   entra        real sign-in with Microsoft Entra External ID. The production
#                mode. Needs every ENTRA_* setting below, APP_ORIGIN,
#                SESSION_SECRET and IDENTITY_ASSERTION_SECRET, and the API in
#                its own AUTH_MODE=entra (services/api/.env.example).
# Anything else, or a mode missing what it needs, is refused (every request
# answers 500 auth_misconfigured) — never a fallback to the development identity.
# AUTH_MODE=development

# Development identity. Sent as X-Dev-User-Email by the proxy in development
# mode; offered on the sign-in form in dev-session mode. Unused under entra.
DEV_USER_EMAIL=dev@easyapply.local

# dev-session and entra: the key sessions are signed with (and, under entra,
# sign-in transactions sealed with), at least 32 random characters. Changing it
# signs everyone out. During a planned rotation put the old value in
# SESSION_SECRET_PREVIOUS (still accepted, never used to sign) until
# SESSION_MAX_AGE_SECONDS has passed, then remove it.
# SESSION_MAX_AGE_SECONDS: dev-session default 43200 (12h); entra default 28800 (8h).
# SESSION_SECRET=
# SESSION_SECRET_PREVIOUS=
# SESSION_MAX_AGE_SECONDS=

# --- entra only ---------------------------------------------------------------
# This app's public origin, exactly as users reach it (https unless loopback), no
# path. Microsoft returns to ${APP_ORIGIN}/api/auth/callback and, after sign-out,
# ${APP_ORIGIN}/signed-out: register BOTH as Web redirect URIs in the app
# registration. Its host must be loopback or listed in PROXY_ALLOWED_HOSTS.
# APP_ORIGIN=https://easyapply.example.com
# The External ID tenant's GUID (Directory (tenant) ID).
# ENTRA_TENANT_ID=
# Where discovery is fetched: https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0
# ENTRA_AUTHORITY=
# The issuer ID tokens must carry. Default https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
# (lower-case tenant id). The discovery document must declare exactly this.
# ENTRA_ISSUER=
# The app registration's Application (client) ID, and a client secret for it.
# Server-side only: never NEXT_PUBLIC_, never in the extension, never logged.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Signs the per-request identity assertion the API verifies. The SAME value as
# the API's IDENTITY_ASSERTION_SECRET; at least 32 characters; never SESSION_SECRET.
# IDENTITY_ASSERTION_SECRET=
# The app role whose holders may use /internal (default EasyApply.Operator).
# ENTRA_OPERATOR_ROLE=EasyApply.Operator

# Hostnames (comma-separated) this server answers for besides loopback. A
# deployment MUST list its public hostname (the one in APP_ORIGIN).
# PROXY_ALLOWED_HOSTS=

# Chrome extensions allowed to make the extension's three workflow writes
# through the proxy, as comma-separated extension ids. Empty by default: no
# extension can write. The EasyApply extension's id is fixed by the key in
# apps/extension/src/manifest.json — see apps/extension/README.md.
# PROXY_ALLOWED_EXTENSION_IDS=jjhciekcmhmngciccfgignmmlgjknakk

# Operator token for the internal operations pages. Server-side only — the
# proxy attaches it for /api/backend/internal/* only, and under entra only for
# holders of the operator role. Must match OPERATOR_API_TOKEN in services/api.
# Leave unset in development; the API boundary is open without it.
# OPERATOR_API_TOKEN=
