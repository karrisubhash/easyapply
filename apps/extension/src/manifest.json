{
  "manifest_version": 3,
  "name": "EasyApply",
  "description": "Save the job you are viewing, see how your profile matches it, tailor a resume, and prepare the application form. You review everything; it never submits.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "action": {
    "default_title": "EasyApply: this job",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://job-boards.greenhouse.io/*", "https://job-boards.eu.greenhouse.io/*", "https://jobs.lever.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://job-boards.greenhouse.io/*", "https://job-boards.eu.greenhouse.io/*", "https://jobs.lever.co/*"]
}
