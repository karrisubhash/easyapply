# EasyApply API — example configuration. Copy to .env and fill in.
# NEVER commit a real .env: it holds the database password and, in production,
# the identity assertion secret. Every setting is read by app/core/config.py.

# --- database and storage ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/easyapply
# RESUME_STORAGE_ROOT=./var/resume-storage

# --- environment ------------------------------------------------------------
# development | test | production. Production refuses the development identity
# on every request; set it explicitly — it is the one way to fail closed.
ENVIRONMENT=development

# Hostnames (comma-separated) the API answers for besides loopback. A deployment
# behind a gateway MUST list the hostname requests arrive with.
# API_ALLOWED_HOSTS=

# --- identity (docs/authentication.md) --------------------------------------
# development  X-Dev-User-Email from the web app (its development AND dev-session
#              modes); DEV_USER_EMAIL when absent. Refused under ENVIRONMENT=production.
#              A bearer assertion is refused: that is a web app in entra mode in
#              front of an API left in development, which would merge every account.
# entra        the web app's signed assertion of a Microsoft Entra External ID
#              sign-in. X-Dev-User-Email is refused. The production mode.
# ("dev-session" is a WEB mode; the API refuses it with a message saying so.)
AUTH_MODE=development
DEV_USER_EMAIL=dev@easyapply.local

# entra only. The web app signs, the API verifies: the SAME value on both tiers,
# at least 32 characters, random, and never the web app's SESSION_SECRET.
# Rotation: set the new value, move the old one to _PREVIOUS on the API first,
# then change the web app, then clear _PREVIOUS (assertions live 60 seconds).
# IDENTITY_ASSERTION_SECRET=
# IDENTITY_ASSERTION_SECRET_PREVIOUS=
# The External ID tenant's GUID, and the issuer its tokens carry
# (https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0 — lower-case tenant id).
# ENTRA_TENANT_ID=
# ENTRA_ISSUER=
# The app role whose holders may use /internal/* (with OPERATOR_API_TOKEN).
# ENTRA_OPERATOR_ROLE=EasyApply.Operator

# --- operator surface (/internal/*) ------------------------------------------
# Shared with the web app's proxy, which attaches it for operators only.
# Unset: /internal/* is open in development (logged) and refused in production.
# OPERATOR_API_TOKEN=

# --- AI (off by default; see docs) -------------------------------------------
# RESUME_AI_ENABLED=false
# JOB_AI_ENABLED=false
# TAILORING_AI_ENABLED=false
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
